# ===================== General =====================
APP_NAME="Парсер эмиссионки"
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ===================== Database =====================
# SQLite (local MVP):
DATABASE_URL=sqlite+aiosqlite:///./storage/bond_parser.db
# PostgreSQL (docker-compose / prod):
# DATABASE_URL=postgresql+asyncpg://bond:bond@localhost:5432/bond_parser
DB_ECHO=false

# ===================== Storage =====================
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# ===================== Extraction =====================
# auto = docling, если установлен, иначе pymupdf+pdfplumber
EXTRACTOR_BACKEND=auto

# ===================== LLM: Qwen 2.5 =====================
# Провайдер: ollama | vllm | openrouter
LLM_PROVIDER=ollama

# Ollama (по умолчанию):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:32b
# Альтернатива полегче для CPU/демо: qwen2.5:14b

# vLLM:
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct-AWQ

# OpenRouter (облачный Qwen 2.5) — ключ ТОЛЬКО в локальном .env, не в git:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_NAME=qwen/qwen-2.5-72b-instruct
# LLM_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# Локальному OpenAI-compatible API ключ не нужен; для OpenRouter — ваш ключ
LLM_API_KEY=not-needed

# Параметры инференса, оптимальные для Qwen 2.5 на длинных эмиссионных документах
LLM_TEMPERATURE=0.05
LLM_MAX_TOKENS=8192
# Важно: Ollama по умолчанию режет контекст до 2–4k — задаём явно
LLM_CONTEXT_WINDOW=32768
LLM_REPEAT_PENALTY=1.05
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=300
LLM_MAX_INPUT_CHARS=100000
# Qwen 2.5: максимальная стабильность на вложенных схемах — MD_JSON
LLM_INSTRUCTOR_MODE=MD_JSON
# true — форсировать MockLLMBondParser (офлайн-демо без Ollama)
LLM_USE_MOCK=false

# ===================== Collector =====================
RSS_URL=https://www.e-disclosure.ru/rss/rss.aspx
RSS_USE_MOCK=true
RSS_KEYWORDS=["решение о выпуске","проспект ценных бумаг","облигац"]
MOEX_ISS_BASE_URL=https://iss.moex.com/iss
HTTP_TIMEOUT_SECONDS=30

# ===================== Scheduler =====================
SCHEDULER_ENABLED=true
COLLECTOR_INTERVAL_MINUTES=30

# ===================== Data Quality Gate =====================
AMORTIZATION_TOLERANCE=0.01
NOMINAL_TOLERANCE=0.01
